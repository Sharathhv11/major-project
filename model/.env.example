# Hugging Face sequence-classification model used for SMS fraud detection
HF_MODEL_ID=VynoDePal/sentra-sms-fraud-detector

# Classification thresholds
# Messages with fraud_probability >= FRAUD_THRESHOLD are labeled FRAUD
FRAUD_THRESHOLD=0.75
# Messages between SUSPICIOUS_THRESHOLD and FRAUD_THRESHOLD are flagged as SUSPICIOUS
SUSPICIOUS_THRESHOLD=0.45

# Context-aware text normalization
ENABLE_PREPROCESSING=true

# Reject request bodies longer than this many characters
MAX_TEXT_LENGTH=2000

# Tokenizer truncation length (tokens, Sentra trained on 128)
MAX_TOKENS=128
