# Environment Variables
# Copy this file to .env and fill in the values

PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/fraud_detection_db

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ML Fraud Model
# URL of the FastAPI ML fraud detection service.
# Local dev: http://127.0.0.1:8000
# Docker:    http://host.docker.internal:8000
FRAUD_MODEL_URL=http://127.0.0.1:8000

# Fraud score threshold (0.0 – 1.0).
# Messages with ML fraud_probability >= this value are flagged as fraud.
# The ML model returns fraud_probability on a 0–1 scale (softmax probability).
FRAUD_SCORE_THRESHOLD=0.75
